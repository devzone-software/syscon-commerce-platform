    "/api/auth/register": {
      "post": {
        "summary": "Registrar cliente",
        "tags": [
          "auth"
        ],
        "responses": {
          "401": {
            "description": "Autenticación requerida"
          },
          "403": {
            "description": "Permiso o propietario inválido"
          },
          "404": {
            "description": "Recurso no encontrado"
          },
          "409": {
            "description": "Conflicto de estado o stock"
          },
          "422": {
            "description": "Validación fallida"
          },
          "201": {
            "description": "Operación completada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 12
