          }
        }
      },
      "post": {
        "summary": "ADMIN: crear o actualizar por SKU",
        "tags": [
          "catalog"
        ],
        "responses": {
          "200": {
            "description": "Operación completada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          },
          "401": {
            "description": "Autenticación requerida"
          },
          "403": {
            "description": "Permiso o propietario inválido"
          },
          "404": {
            "description": "Recurso no encontrado"
          },
          "409": {
            "description": "Conflicto de estado o stock"
          },
          "422": {
            "description": "Validación fallida"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "sku": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "price": {
                    "type": "string",
                    "pattern": "^\\d+(\\.\\d{1,2})?$",
                    "example": "10.15"
                  },
                  "stock": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "imageUrl": {
                    "type": "string",
                    "format": "uri",
                    "nullable": true
                  },
                  "category": {
                    "type": "string"
                  },
                  "brand": {
                    "type": "string"
                  },
                  "active": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "sku",
                  "name",
                  "price",
                  "stock",
                  "active"
                ]
              }
            }
          }
        }
      }
    },
