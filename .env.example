APP_NAME="SYSCON Commerce"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stack
LOG_LEVEL=info
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=commerce
DB_USERNAME=syscon
DB_PASSWORD=
SESSION_DRIVER=file
CACHE_STORE=database
QUEUE_CONNECTION=sync
JWT_SECRET=
SERVICE_TOKEN=
# Correos al cliente (pedido, pago confirmado, comprobante). Con MAIL_MAILER=log solo se registran.
# WEB_URL es la tienda: los correos enlazan a {WEB_URL}/pedido/{id}.
WEB_URL=
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=ventas@tu-dominio.com
MAIL_FROM_NAME="${APP_NAME}"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# Web OAuth client id de Google (el mismo del frontend); vacío desactiva el login con Google
GOOGLE_CLIENT_ID=
# Entrega. Retiro en tienda: dirección y horario que ve el cliente. Envío a domicilio: tarifa fija
# en soles (p. ej. 15.00) y zonas atendidas; DELIVERY_FEE vacío desactiva el envío.
PICKUP_ADDRESS=
PICKUP_HOURS=
DELIVERY_FEE=
DELIVERY_AREAS=
# Horas que un pedido impago mantiene su reserva de stock antes de vencer (0 = no vence).
# El scheduler ejecuta orders:expire cada 5 minutos (php artisan schedule:run por cron).
ORDER_RESERVATION_HOURS=48
# Instrucciones del pago manual que ve el cliente; \n para saltos de línea.
MANUAL_PAYMENT_INSTRUCTIONS=
# Pasarela simulada (solo desarrollo): true y un secreto aleatorio para firmar el webhook.
PAYMENT_SANDBOX=false
PAYMENT_SANDBOX_SECRET=
SUPPLIER_ALLOWED_HOSTS=
# Precios con IGV incluido; la tasa solo separa base e impuesto.
IGV_RATE=0.18
# Consulta de RUC al facturar: migo (proveedor real), none (desactivada) o fake (datos de prueba, solo desarrollo).
# Con migo, RUC_LOOKUP_TOKEN es el token de api.migo.pe/tokens; sin token la consulta queda desactivada.
RUC_LOOKUP_DRIVER=none
RUC_LOOKUP_TOKEN=
SUNAT_RUC=
SUNAT_LEGAL_NAME=SYSCON
SUNAT_SOL_USER=
SUNAT_SOL_PASSWORD=
SUNAT_CERTIFICATE_PATH=
SUNAT_CERTIFICATE_PASSWORD=
SUNAT_ENDPOINT=https://e-beta.sunat.gob.pe/ol-ti-itcpfegem-beta/billService
SUNAT_ESTABLISHMENT_CODE=0000
SUNAT_ADDRESS=
